# ── Application ──────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── OCR ───────────────────────────────────────────────────────────────────────
# Path to Tesseract executable (Windows example below)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_LANG=eng+hin+mar
OCR_CONFIDENCE_THRESHOLD=0.6

# ── Models (HuggingFace Hub IDs) ─────────────────────────────────────────────
NER_MODEL_NAME=dslim/bert-base-NER
CLASSIFIER_MODEL_NAME=distilbert-base-uncased
CORRECTION_MODEL_NAME=dmis-lab/biobert-base-cased-v1.2
TRANSLATION_EN_HI_MODEL=Helsinki-NLP/opus-mt-en-hi
TRANSLATION_EN_MR_MODEL=Helsinki-NLP/opus-mt-en-mr

# ── Training Hyperparameters ──────────────────────────────────────────────────
NER_TRAIN_EPOCHS=5
NER_BATCH_SIZE=16
NER_LR=5e-5
NER_MAX_LENGTH=256

CLASSIFIER_TRAIN_EPOCHS=5
CLASSIFIER_BATCH_SIZE=16
CLASSIFIER_LR=2e-5
CLASSIFIER_MAX_LENGTH=256

# ── Limits ────────────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=20
